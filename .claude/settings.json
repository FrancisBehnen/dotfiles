{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDISH_PROVIDER": "claude-cli",
    "CLAUDISH_MODEL": "haiku",
    "CLAUDISH_SPEAK": "1",
    "CLAUDISH_DEBUG": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(bun *)",
      "Bash(pip *)",
      "Bash(pipx *)",
      "Bash(pipenv *)",
      "Bash(poetry *)",
      "Bash(pytest *)",
      "Bash(coverage *)",
      "Bash(jest *)",
      "Bash(vitest *)",
      "Bash(go test *)",
      "Bash(mvn *)",
      "Bash(gradle *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(ruff *)",
      "Bash(black *)",
      "Bash(isort *)",
      "Bash(rm *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(ls *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(ag *)",
      "Bash(fd *)",
      "Bash(tree *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(command *)",
      "Bash(* --version*)",
      "Bash(* --help*)",
      "Bash(mutagen *)",
      "Bash(.venv/bin/python *.py)",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(rm --rm*)",
      "Bash(rm --empty-trash*)",
      "Bash(rm -rf //)",
      "Bash(rm -rf ~/)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(/etc/**)",
      "Edit(/etc/**)"
    ],
    "ask": [
      "Bash(git*push*--force)",
      "Bash(git*push*--force *)",
      "Bash(git*push*-f)",
      "Bash(git*push*-f *)",
      "Bash(git*reset*--hard*)",
      "Bash(git*clean*-fdx*)",
      "Bash(sudo *)",
      "Bash(chown *)",
      "Bash(chmod 7*)",
      "Bash(mkfs *)",
      "Bash(dd if=*)",
      "Bash(gh issue delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh release delete*)",
      "Bash(gh label delete*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "deniedMcpServers": [
    {
      "serverName": "google-cloud-bigquery"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "claude-obsidian@agricidaniel-claude-obsidian": true,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "plannotator@plannotator": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "claudish-to-english@claudish-tts": true
  },
  "extraKnownMarketplaces": {
    "agricidaniel-claude-obsidian": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-obsidian"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "claudish-tts": {
      "source": {
        "source": "github",
        "repo": "FrancisBehnen/claudish-to-spoken-english"
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "srv1407177.hstgr.cloud",
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "https://3505is6p8i-vpce-00a4473996edc4a88.execute-api.eu-west-1.amazonaws.com/production/ground-truth/aggregated",
        "localhost"
      ],
      "allowManagedDomainsOnly": false
    },
    "filesystem": {
      "allowWrite": [
        "~/.claude",
        "~/.cache",
        "~/.npm",
        "~/.local/share",
        "~/.config",
        "~/.gitconfig",
        "~/.rm-safely-undo-stack",
        "~/.rm-safely-undo-stack.tmp",
        "~/.bun",
        ".git",
        "~/Library/Caches/ms-playwright"
      ],
      "denyWrite": [
        "//bin",
        "//usr",
        "//lib",
        "//lib64",
        "//opt",
        "//sbin",
        "//System",
        "//Applications",
        "//etc",
        "//var",
        "//root"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/Documents",
        "~/Desktop",
        "~/Downloads",
        "~/Pictures",
        "~/Music",
        "~/Movies",
        "~/Library",
        "//root",
        "//etc",
        "//System",
        "//Applications"
      ],
      "allowRead": [
        "~/.ssh/config",
        "~/.Trash",
        "~/Library/Caches/ms-playwright",
        "/var/select/developer_dir",
        "/private/var/select",
        "/private/var/select/developer_dir",
        "/System/Library/CoreServices/SystemVersion.plist",
        "/Applications/Xcode.app",
        "/Applications/Xcode-*.app"
      ]
    },
    "excludedCommands": [
      "git",
      "/usr/bin/git",
      "config",
      "plannotator"
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "skipDangerousModePermissionPrompt": true,
  "verbose": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: PUBLIC — FrancisBehnen/claudish-to-spoken-english (github.com/FrancisBehnen/claudish-to-spoken-english); any push there is publishing",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main; no rulesets or protected branches listed via gh",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (FrancisBehnen/claudish-to-spoken-english, origin) and its upstream remote (gvzdv/claudish-to-english) only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: $HOME/Code/claudish-to-spoken-english (origin: FrancisBehnen/claudish-to-spoken-english, public — only this repo's own work belongs here; content ported or first read from elsewhere is not its own work; upstream gvzdv/claudish-to-english is a pull/reference remote, not a push target) — confidential material and secrets are never cleared into this repo by its public visibility",
      "**Org-specific CLIs**: None configured",
      "routine under $HOME/Code/claudish-to-spoken-english/ prefix"
    ]
  },
  "voiceEnabled": true
}
