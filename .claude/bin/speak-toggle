#!/bin/sh
# Toggle the claudish speech mute, without a path to mistype.
#
#   speak-toggle          flip
#   speak-toggle off      mute   (create the flag file)
#   speak-toggle on       unmute (remove it)
#   speak-toggle status   report
#
# Honours CLAUDISH_SPEAK_OFF_FILE exactly as speak.sh and speak-child.py do.
# Written with > rather than touch, so a stray trailing slash is an error you
# see instead of a mute that silently never happened.

F="${CLAUDISH_SPEAK_OFF_FILE:-$HOME/.claude/claudish-speak-off}"
F="${F%/}"

# The hooks read this with [ -f ] (speak.sh) and os.path.exists (speak-child),
# so only a regular file mutes both legs. Refuse to leave anything else here.
if [ -e "$F" ] && [ ! -f "$F" ]; then
  printf 'speak-toggle: %s exists and is not a regular file; refusing.\n' "$F" >&2
  exit 1
fi

muted() { [ -f "$F" ]; }

case "${1:-toggle}" in
  off|mute)    : > "$F" || exit 1 ;;
  on|unmute)   command rm -f -- "$F" || exit 1 ;;
  status)      ;;
  toggle)      if muted; then command rm -f -- "$F" || exit 1
               else : > "$F" || exit 1; fi ;;
  *) printf 'usage: speak-toggle [on|off|toggle|status]\n' >&2; exit 2 ;;
esac

if muted; then printf 'speech OFF  (%s)\n' "$F"
else           printf 'speech ON   (no %s)\n' "$F"; fi
