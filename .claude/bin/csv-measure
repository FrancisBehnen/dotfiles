#!/usr/bin/env python3
"""csv-measure — read a CSV the way real files actually are, and report counts with their units.

Why this exists
---------------
Every session that opens a CSV re-derives the same handful of traps, gets a
plausible-looking wrong number, and argues about it. This bakes them in once:

  1. UTF-8 BOM on the first header cell   -> decoded with utf-8-sig.
  2. Column-aligned, space-padded files   -> a space before an opening quote defeats
     csv.reader's quoting and fields split on their own internal commas
     (a 22-column row reads as 23-27 cells). Fixed by skipinitialspace=True.
  3. Space-padded HEADER cells            -> the half that gets missed. With (2) alone,
     DictReader keys keep their trailing spaces, every lookup returns None, and the
     file looks EMPTY rather than BROKEN. Header keys are stripped -- and so are cell
     values, because skipinitialspace already strips the leading side and half-stripping
     is the inconsistency that makes 'Intel' and 'Intel   ' two different brands.
  4. Appended human review notes          -> a hand-annotated file can end in lines that
     are not rows. They are listed verbatim, never counted as rows, never called
     corruption. You decide which they are.
  5. Counts differ by unit                -> physical lines != non-blank lines != parsed
     records != full-width data rows != distinct values in a key column. Every number
     this tool prints carries its unit, so a number lifted out of it into an argument
     carries the unit with it.
  6. A number is usually being CHECKED     -> the caller nearly always already holds a
     number a previous session asserted, and wants to know whether it still holds.
     Comparing the printed number by eye is the step that lets a stale "23/43" travel
     into a brief. --expect turns that comparison into an exit status, and --digest
     gives a file-level baseline that an md5 cannot, because these files are
     hand-aligned and annotated between sessions while the data is identical.

Nothing here is specific to any one pipeline: column names are always arguments,
never defaults. Python standard library only, so it runs with no venv.
"""

from __future__ import annotations

import argparse
import codecs
import csv
import hashlib
import io
import json
import os
import sys
from collections import Counter, OrderedDict

VERSION = "1.1"

# csv.field_size_limit defaults to 128 KiB; long generated text fields exceed it.
csv.field_size_limit(16 * 1024 * 1024)


# --------------------------------------------------------------------------- read


class CsvReadError(Exception):
    pass


def _resolve_delimiter(raw: str) -> str:
    aliases = {"tab": "\t", "\\t": "\t", "semicolon": ";", "pipe": "|", "comma": ","}
    d = aliases.get(raw, raw)
    if len(d) != 1:
        raise CsvReadError(f"--delimiter must resolve to exactly one character, got {raw!r}")
    return d


def read_csv(path, delimiter=",", encoding="utf-8-sig", naive=False):
    """Parse one CSV and return a dict of measurements, columns, notes and rows.

    naive=True disables every quirk fix (no skipinitialspace, no stripping of header
    keys or cell values). It exists to show what a careless read WOULD have returned --
    use it to tell an instrument problem apart from a data problem, not to get real
    numbers.
    """
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except OSError as exc:
        raise CsvReadError(f"cannot read {path}: {exc}") from exc

    bom = raw.startswith(codecs.BOM_UTF8)
    try:
        text = raw.decode(encoding)
    except UnicodeDecodeError as exc:
        raise CsvReadError(f"cannot decode {path} as {encoding}: {exc}") from exc

    # Physical lines, counted so that a final line WITHOUT a trailing newline still
    # counts. (`wc -l` counts newline characters and undercounts such a file by one.)
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    physical_lines = len(lines)
    # .strip() so a bare CR left by CRLF endings reads as blank, as it should.
    # (`grep -c .` counts such a line as non-blank -- it sees the \r as a character.)
    non_blank_lines = sum(1 for line in lines if line.strip())
    crlf = "\r\n" in text

    reader = csv.reader(
        io.StringIO(text, newline=""),
        delimiter=delimiter,
        skipinitialspace=not naive,
    )

    records = []  # (end_line_number, fields)
    prev_line = 0
    try:
        for fields in reader:
            records.append((prev_line + 1, fields))
            prev_line = reader.line_num
    except csv.Error as exc:
        raise CsvReadError(f"{path}: CSV parse error near line {reader.line_num}: {exc}") from exc

    if not records:
        raise CsvReadError(f"{path} is empty -- no header row")

    header_line, header_fields = records[0]
    raw_columns = list(header_fields)
    columns = raw_columns if naive else [c.strip() for c in raw_columns]
    header_padded = any(c != c.strip() for c in raw_columns)
    width = len(columns)

    dupe_columns = sorted(name for name, n in Counter(columns).items() if n > 1)

    rows = []
    notes = []
    blank_records = 0
    values_padded = False
    for line_no, fields in records[1:]:
        if not fields or (len(fields) <= 1 and all(f.strip() == "" for f in fields)):
            blank_records += 1
            continue
        if len(fields) == width:
            if not naive:
                if any(f != f.strip() for f in fields):
                    values_padded = True
                fields = [f.strip() for f in fields]
            rows.append(OrderedDict(zip(columns, fields)))
        else:
            notes.append(
                {
                    "line": line_no,
                    "fields": len(fields),
                    "text": lines[line_no - 1].rstrip("\r") if line_no <= len(lines) else "",
                }
            )

    return {
        "path": os.path.abspath(path),
        "name": os.path.basename(path),
        "encoding": encoding,
        "bom": bom,
        "crlf_line_endings": crlf,
        "delimiter": delimiter,
        "naive": naive,
        "header_cells_were_padded": header_padded,
        "cell_values_were_padded": values_padded,
        "duplicate_column_names": dupe_columns,
        "columns": columns,
        "counts": {
            "physical_lines": physical_lines,
            "non_blank_lines": non_blank_lines,
            "records_parsed": len(records),
            "header_rows": 1,
            "header_columns": width,
            "data_rows": len(rows),
            "non_conforming_lines": len(notes),
            "blank_records": blank_records,
        },
        "notes": notes,
        "rows": rows,
    }


# ----------------------------------------------------------------------- analysis


def require_columns(result, names):
    missing = [n for n in names if n not in result["columns"]]
    if missing:
        raise CsvReadError(
            "no such column(s) in {}: {}\navailable columns ({}): {}".format(
                result["name"],
                ", ".join(repr(m) for m in missing),
                len(result["columns"]),
                ", ".join(result["columns"]),
            )
        )


def distinct_report(result, column):
    require_columns(result, [column])
    values = [r[column] for r in result["rows"]]
    non_empty = [v for v in values if v.strip() != ""]
    counts = Counter(non_empty)
    duplicates = [(v, n) for v, n in counts.most_common() if n > 1]
    return {
        "column": column,
        "data_rows": len(values),
        "blank_values": len(values) - len(non_empty),
        "distinct_values": len(counts),
        "duplicated_values": [{"value": v, "rows": n} for v, n in duplicates],
    }


def group_report(result, columns):
    require_columns(result, columns)
    counts = Counter(tuple(r[c] for c in columns) for r in result["rows"])
    return {
        "columns": columns,
        "groups": len(counts),
        "data_rows": len(result["rows"]),
        "counts": [
            {"key": list(k), "rows": n}
            for k, n in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
        ],
    }


# ------------------------------------------------------------------------- digest

# Bumped only when the normalisation below changes, so an old digest in a session file
# fails loudly against a new algorithm instead of silently comparing unequal things.
DIGEST_VERSION = "csvm1"


def content_digest(result):
    """sha256 over the parsed DATA ROWS only, normalised -- a file md5 that survives review.

    A plain md5 of these files is useless: they are hand-aligned and get review notes
    appended between sessions, so the bytes change on every pass while the pipeline
    output is identical. This hashes the DATA, not the file:

      in  (changes the digest)   cell values, the set of column NAMES, how many rows,
                                 which rows
      out (does not)             UTF-8 BOM, CRLF vs LF, a trailing newline, column
                                 alignment padding, appended non-conforming note lines,
                                 blank lines, ROW ORDER, COLUMN ORDER

    Row order is deliberately NOT part of the identity. The digest answers "is this the
    same data?", and every documented edit Francis makes to these files is a layout
    edit -- aligning columns, appending notes, sorting a scratchpad in a spreadsheet. A
    digest that a sort breaks would fail on exactly the case it exists to survive. The
    pipeline's write order is deterministic, and where order carries meaning it is also
    in the data (rank, permutation_id), so an order-only change is recoverable from the
    rows themselves rather than from their sequence. Column order is excluded for the
    same reason and by the same principle: identity is the content, not the layout.
    Duplicate rows still count -- rows are hashed as a multiset, not a set.
    """
    row_hashes = sorted(
        hashlib.sha256(
            json.dumps(dict(row), ensure_ascii=False, sort_keys=True,
                       separators=(",", ":")).encode("utf-8")
        ).hexdigest()
        for row in result["rows"]
    )
    h = hashlib.sha256()
    h.update(("csv-measure/{}\ncolumns:{}\nrows:{}\n".format(
        DIGEST_VERSION,
        json.dumps(sorted(result["columns"]), ensure_ascii=False, separators=(",", ":")),
        len(row_hashes))).encode("utf-8"))
    for rh in row_hashes:
        h.update((rh + "\n").encode("ascii"))
    return "{}:{}".format(DIGEST_VERSION, h.hexdigest())


# ------------------------------------------------------------------------- expect

# expectation key -> (counts key, the unit as printed in the report)
EXPECT_COUNT_KEYS = OrderedDict([
    ("rows", ("data_rows", "data rows")),
    ("cols", ("header_columns", "header columns")),
    ("notes", ("non_conforming_lines", "non-conforming lines")),
    ("blank", ("blank_records", "blank records")),
    ("lines", ("physical_lines", "physical lines")),
    ("non-blank", ("non_blank_lines", "non-blank lines")),
    ("records", ("records_parsed", "records parsed")),
])

EXPECT_KEY_HELP = (
    "known keys: " + ", ".join(EXPECT_COUNT_KEYS) +
    ", distinct:COLUMN, groups:COLUMN[+COLUMN...], digest"
)


def parse_expectations(specs):
    """['rows=45,cols=22'] -> [(key, kind, param, expected)]. Raises on anything unknown.

    An unknown key is an error, never a silently skipped check: a false pass here is
    worse than a false fail, because it is the thing the caller is trusting.
    """
    out = []
    seen = set()
    for spec in specs:
        for pair in spec.split(","):
            pair = pair.strip()
            if not pair:
                continue
            if "=" not in pair:
                raise CsvReadError(
                    "--expect item {!r} is not KEY=VALUE.\n{}".format(pair, EXPECT_KEY_HELP))
            key, value = (p.strip() for p in pair.split("=", 1))
            if not key:
                raise CsvReadError("--expect item {!r} has an empty key.\n{}".format(
                    pair, EXPECT_KEY_HELP))
            if key in seen:
                raise CsvReadError("--expect key {!r} given more than once".format(key))
            seen.add(key)

            if key in EXPECT_COUNT_KEYS:
                kind, param = "count", EXPECT_COUNT_KEYS[key][0]
            elif key.startswith("distinct:"):
                kind, param = "distinct", key[len("distinct:"):].strip()
                if not param:
                    raise CsvReadError("--expect {!r} names no column".format(key))
            elif key.startswith("groups:"):
                kind = "groups"
                param = [c.strip() for c in key[len("groups:"):].split("+") if c.strip()]
                if not param:
                    raise CsvReadError("--expect {!r} names no columns".format(key))
            elif key == "digest":
                kind, param = "digest", None
            else:
                raise CsvReadError("unknown --expect key {!r}.\n{}".format(key, EXPECT_KEY_HELP))

            if kind == "digest":
                if not value:
                    raise CsvReadError("--expect digest= needs a digest value")
                expected = value
            else:
                try:
                    expected = int(value)
                except ValueError:
                    raise CsvReadError(
                        "--expect {}={!r} must be a whole number".format(key, value)) from None
            out.append((key, kind, param, expected))
    if not out:
        raise CsvReadError("--expect was given nothing to check.\n" + EXPECT_KEY_HELP)
    return out


def evaluate_expectations(result, expectations):
    """Measure each expectation against one file. A missing column raises (exit 2)."""
    checks = []
    for key, kind, param, expected in expectations:
        if kind == "count":
            measured = result["counts"][param]
            unit = next(u for k, (ck, u) in EXPECT_COUNT_KEYS.items() if ck == param)
        elif kind == "distinct":
            measured = distinct_report(result, param)["distinct_values"]
            unit = "distinct values in '{}'".format(param)
        elif kind == "groups":
            measured = group_report(result, param)["groups"]
            unit = "groups of {}".format(" x ".join(param))
        else:
            measured = content_digest(result)
            unit = "digest of the parsed data rows"
        checks.append({"key": key, "unit": unit, "expected": expected,
                       "measured": measured, "ok": measured == expected})
    return checks


def print_expectations(result, checks, out):
    out.write("{}\n".format(result["path"]))
    width = max(len(c["key"]) for c in checks)
    for c in checks:
        if c["ok"]:
            out.write("  PASS  {:<{w}}  {}  ({})\n".format(
                c["key"], c["measured"], c["unit"], w=width))
        else:
            out.write("  FAIL  {:<{w}}  expected {}, measured {}  ({})\n".format(
                c["key"], c["expected"], c["measured"], c["unit"], w=width))
    failed = [c for c in checks if not c["ok"]]
    out.write("  {}: {} of {} expectation{} {}\n".format(
        "FAIL" if failed else "PASS",
        len(failed) if failed else len(checks), len(checks),
        "" if len(checks) == 1 else "s",
        "not met" if failed else "met"))
    return not failed


# ----------------------------------------------------------------------- selftest

# The digest's whole value is that a stored baseline stays comparable. A refactor that
# quietly changes the normalisation would break every baseline ever written down, so the
# claims are pinned here: `csv-measure --selftest`, no pytest, no fixtures on disk.
SELFTEST_GOLDEN = "csvm1:ad27061b4e153f8e7f3800d61c6465b513a58b9db8dcdc415b1aed68c1203766"

_SELFTEST_ROWS = [
    ["id", "brand", "sentence"],
    ["1", "Intel", "Werk aan meer dingen tegelijk, zonder haperen."],
    ["2", "AMD", 'Een "snellere" chip, met komma, in de tekst.'],
    ["3", "Intel", "Ünïcode en trailing spaces."],
]


def _selftest_files(tmpdir):
    """Same three data rows, written the many ways these files actually turn up."""
    import os as _os

    def w(name, text, bom=False, encoding="utf-8"):
        path = _os.path.join(tmpdir, name)
        data = text.encode(encoding)
        if bom:
            data = codecs.BOM_UTF8 + data
        with open(path, "wb") as fh:
            fh.write(data)
        return path

    def serialise(rows, sep=",", pad=0, newline="\n"):
        widths = [max(len(r[i]) for r in rows) + pad for i in range(len(rows[0]))]
        out = []
        for r in rows:
            cells = []
            for i, cell in enumerate(r):
                q = '"{}"'.format(cell.replace('"', '""')) if (
                    sep in cell or '"' in cell) else cell
                cells.append(q.rjust(widths[i]) if pad else q)
            out.append(sep.join(cells))
        return newline.join(out) + newline

    rows = _SELFTEST_ROWS
    plain = w("plain.csv", serialise(rows))
    aligned = w("aligned.csv",
                serialise(rows, pad=3, newline="\r\n") + "- reviewer note\r\n- another\r\n",
                bom=True)
    no_trailing = w("no_trailing.csv", serialise(rows).rstrip("\n"))
    reordered = w("reordered.csv", serialise([rows[0]] + [rows[3], rows[1], rows[2]]))
    cols_reordered = w("cols_reordered.csv",
                       serialise([[r[2], r[0], r[1]] for r in rows]))
    changed = w("changed.csv", serialise(
        [rows[0], rows[1], rows[2], [rows[3][0], rows[3][1], rows[3][2] + "!"]]))
    dropped = w("dropped.csv", serialise(rows[:3]))
    renamed = w("renamed.csv", serialise([["id", "merk", "sentence"]] + rows[1:]))
    return {"plain": plain, "aligned": aligned, "no_trailing": no_trailing,
            "reordered": reordered, "cols_reordered": cols_reordered,
            "changed": changed, "dropped": dropped, "renamed": renamed}


def selftest(out):
    import tempfile

    failures = []
    with tempfile.TemporaryDirectory(prefix="csv-measure-selftest-") as tmp:
        paths = _selftest_files(tmp)
        dg = {k: content_digest(read_csv(p)) for k, p in paths.items()}

        def check(label, ok, detail=""):
            out.write("  {}  {}{}\n".format("PASS" if ok else "FAIL", label,
                                            "" if ok else "  -- " + detail))
            if not ok:
                failures.append(label)

        base = dg["plain"]
        for k, why in [("aligned", "BOM + CRLF + alignment padding + appended notes"),
                       ("no_trailing", "no trailing newline"),
                       ("reordered", "data rows in a different order"),
                       ("cols_reordered", "columns in a different order")]:
            check("stable across {}".format(why), dg[k] == base,
                  "{} != {}".format(dg[k], base))
        for k, why in [("changed", "one cell changed"),
                       ("dropped", "one row removed"),
                       ("renamed", "one column renamed")]:
            check("sensitive to {}".format(why), dg[k] != base, "digest did not move")

        check("counts on the annotated variant (3 rows, 3 cols, 2 notes)",
              [read_csv(paths["aligned"])["counts"][k]
               for k in ("data_rows", "header_columns", "non_conforming_lines")] == [3, 3, 2])
        check("golden digest unchanged (bump DIGEST_VERSION if this moves on purpose)",
              base == SELFTEST_GOLDEN, "now {}".format(base))

    out.write("  {}: {} check(s) failed\n".format("FAIL", len(failures)) if failures
              else "  PASS: every check held\n")
    return not failures


# -------------------------------------------------------------------------- print


def print_report(result, distincts, groups, show_columns, out, digest=None):
    c = result["counts"]
    w = out.write
    w("{}\n".format(result["path"]))

    flags = []
    if result["bom"]:
        flags.append("UTF-8 BOM stripped")
    if result["crlf_line_endings"]:
        flags.append("CRLF line endings")
    if result["header_cells_were_padded"]:
        flags.append("header cells were space-padded (keys stripped)")
    if result["cell_values_were_padded"]:
        flags.append("cell values were space-padded (values stripped)")
    if result["naive"]:
        flags.append("NAIVE MODE: quirk handling disabled, numbers are diagnostic only")
    if result["duplicate_column_names"]:
        flags.append("duplicate column names: " + ", ".join(result["duplicate_column_names"]))
    for f in flags:
        w("  ! {}\n".format(f))

    w("  {:<22}{:>7}  {}\n".format("physical lines", c["physical_lines"],
                                   "newline-separated lines, final line counted"))
    w("  {:<22}{:>7}  {}\n".format("non-blank lines", c["non_blank_lines"], ""))
    w("  {:<22}{:>7}  {}\n".format("records parsed", c["records_parsed"],
                                   "= header + data rows + non-conforming + blank"))
    w("  {:<22}{:>7}  {}\n".format("header columns", c["header_columns"],
                                   "fields in the header row"))
    w("  {:<22}{:>7}  {}\n".format("DATA ROWS", c["data_rows"],
                                   "records with exactly {} fields, header excluded".format(
                                       c["header_columns"])))
    w("  {:<22}{:>7}  {}\n".format(
        "non-conforming lines", c["non_conforming_lines"],
        "listed below; NOT counted as data rows" if c["non_conforming_lines"]
        else "every record is header-width"))
    w("  {:<22}{:>7}\n".format("blank records", c["blank_records"]))

    if digest:
        w("  {:<22}{}  {}\n".format("digest", digest,
                                    "data rows only; layout-independent"))

    if result["notes"]:
        w("\n  non-conforming lines (verbatim -- likely appended review notes, "
          "but read them and decide):\n")
        for n in result["notes"]:
            w("    line {:>5} ({} field{}): {}\n".format(
                n["line"], n["fields"], "" if n["fields"] == 1 else "s", n["text"]))

    if show_columns:
        w("\n  columns ({}):\n".format(len(result["columns"])))
        for i, name in enumerate(result["columns"]):
            w("    {:>3}  {}\n".format(i, name))

    for d in distincts:
        w("\n  distinct values in '{}': {} distinct / {} data rows".format(
            d["column"], d["distinct_values"], d["data_rows"]))
        if d["blank_values"]:
            w(" ({} blank)".format(d["blank_values"]))
        w("\n")
        if d["duplicated_values"]:
            w("    {} value(s) appear on more than one row:\n".format(
                len(d["duplicated_values"])))
            for dv in d["duplicated_values"]:
                w("      {:>4} row{}  {}\n".format(
                dv["rows"], " " if dv["rows"] == 1 else "s", dv["value"]))
        elif d["data_rows"] and d["distinct_values"] == d["data_rows"]:
            w("    every data row has a distinct value (no duplicates)\n")

    for g in groups:
        w("\n  grouped by {}: {} group{} / {} data rows\n".format(
            " x ".join(g["columns"]), g["groups"],
            "" if g["groups"] == 1 else "s", g["data_rows"]))
        for item in g["counts"]:
            w("    {:>4} row{}  {}\n".format(
                item["rows"], " " if item["rows"] == 1 else "s", " | ".join(item["key"])))


TABLE_HEADERS = ["lines", "non-blank", "records", "cols", "DATA ROWS", "notes", "blank"]
TABLE_KEYS = ["physical_lines", "non_blank_lines", "records_parsed", "header_columns",
              "data_rows", "non_conforming_lines", "blank_records"]


def print_table(results, out, name_width=None):
    names = [r["name"] if "name" in r else r["path"] for r in results]
    nw = name_width or max([len(n) for n in names] + [4])
    out.write("{:<{nw}}  {}\n".format("file", "  ".join(
        "{:>9}".format(h) for h in TABLE_HEADERS), nw=nw))
    out.write("{}\n".format("-" * (nw + 2 + 11 * len(TABLE_HEADERS))))
    for r, n in zip(results, names):
        out.write("{:<{nw}}  {}\n".format(n, "  ".join(
            "{:>9}".format(r["counts"][k]) for k in TABLE_KEYS), nw=nw))
    out.write("\nunits: lines = newline-separated physical lines (final line counted; "
              "`wc -l` undercounts a file with no trailing newline).\n"
              "       records = everything csv parsed = header + data rows + notes + blank.\n"
              "       DATA ROWS = records with exactly as many fields as the header. "
              "This is the number you mean when you say 'rows'.\n"
              "       notes = non-conforming lines, listed per file with --report.\n")


# --------------------------------------------------------------------------- main


EPILOG = """\
counts, and what each one means
  physical lines        newline-separated lines; a final line with no trailing
                        newline still counts (`wc -l` would undercount it by one)
  non-blank lines       physical lines with any non-whitespace (a bare CR is blank)
  records parsed        everything the CSV parser returned, header included
  header columns        fields in the header row
  data rows             records with exactly as many fields as the header, header
                        excluded -- this is what you mean when you say "rows"
  non-conforming lines  records of any other width, listed verbatim; on a
                        hand-annotated file these are usually appended review notes
  blank records         empty lines

--expect: assert a carried number instead of eyeballing it
  Exit 0 = every expectation met, 1 = at least one mismatch (each printed as
  expected vs measured), 2 = the expectation itself is bad: an unknown key, a
  non-numeric value, or a column that does not exist. Never a silent pass.

    rows=N              data rows            notes=N     non-conforming lines
    cols=N              header columns       blank=N     blank records
    lines=N             physical lines       records=N   records parsed
    non-blank=N         non-blank lines
    distinct:COLUMN=N   distinct non-empty values in COLUMN
    groups:A+B+C=N      distinct groups of columns A, B, C  ('+', not ',',
                        because ',' already separates expectations)
    digest=csvm1:...    the --digest value, matched exactly

  With several files each file is checked separately and reported by path; the
  exit status is non-zero if ANY file fails. That makes `csv-measure out/*.csv
  --expect cols=22` a schema assertion over a set, and keeps a failure attributed
  to the file that caused it.

--digest: the md5 substitute for a file that gets hand-edited
  sha256 over the parsed DATA ROWS only, normalised. Stable across: BOM or no BOM,
  CRLF or LF, column alignment padding, appended review-note lines, a trailing
  newline, ROW ORDER and COLUMN ORDER. Sensitive to: any cell value, a row added or
  removed (duplicates count -- rows hash as a multiset), a column added, removed or
  renamed. Row order is not part of the identity because every documented edit to
  these files is a layout edit, sorting a scratchpad in a spreadsheet included, and
  a digest a sort breaks fails on the case it exists to survive; where order carries
  meaning it is also in the data (rank, permutation_id). Alone it prints just the
  digest per file; with --report or --expect it joins that output.

examples
  csv-measure run.csv
  csv-measure run.csv --distinct permutation_id
  csv-measure run.csv --group cluster_name,consideration_name,brand
  csv-measure output/*.csv --table
  csv-measure run.csv --rows-json | jq '.[0]'
  csv-measure run.csv --naive          # what a careless read would have said
  csv-measure run.csv --digest
  csv-measure run.csv --expect rows=45,cols=22,distinct:permutation_id=45
  csv-measure run.csv --expect digest=csvm1:1a2b3c...   # strongest drift check
  csv-measure clean.csv scratchpad.csv --digest         # same data, different bytes?

Column names are always arguments. This tool has no idea what your columns are
called and never assumes.
"""


def build_parser():
    p = argparse.ArgumentParser(
        prog="csv-measure",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Measure a CSV and report every count with its unit. Handles a UTF-8 BOM, "
            "hand-aligned space padding (in cells AND in header names), and appended "
            "human review notes -- the traps that otherwise make a file read as empty, "
            "over-wide, or silently short. Standard library only."),
        epilog=EPILOG,
    )
    p.add_argument("path", nargs="+", help="CSV file(s) to measure")
    p.add_argument("-D", "--distinct", metavar="COLUMN", action="append", default=[],
                   help="count distinct values in COLUMN (repeatable). Catches a "
                        "silent duplicate in a key column.")
    p.add_argument("-g", "--group", metavar="COLUMN[,COLUMN...]", action="append", default=[],
                   help="group data rows by one or more columns and count each group "
                        "(repeatable)")
    p.add_argument("-e", "--expect", metavar="KEY=VALUE[,KEY=VALUE...]", action="append",
                   default=[],
                   help="assert measurements instead of printing them: exit 0 if every "
                        "one holds, 1 on any mismatch (printed as expected vs measured), "
                        "2 if the expectation itself is bad. " + EXPECT_KEY_HELP +
                        ". Repeatable; with several files each is checked separately.")
    p.add_argument("--digest", action="store_true",
                   help="print a sha256 over the parsed DATA ROWS only, normalised: "
                        "unchanged by a BOM, CRLF, alignment padding, appended review "
                        "notes, a trailing newline, row order or column order; changed by "
                        "any cell value, row or column name. The md5 substitute for a "
                        "file that is hand-edited between sessions. Assert it with "
                        "--expect digest=...")
    p.add_argument("--columns", action="store_true", help="list the header column names")
    p.add_argument("--table", action="store_true",
                   help="one summary line per file (the default when several files "
                        "are given)")
    p.add_argument("--report", action="store_true",
                   help="force the full per-file report even for several files")
    p.add_argument("--json", action="store_true",
                   help="emit the full result as JSON (counts, columns, notes, rows)")
    p.add_argument("--rows-json", action="store_true",
                   help="emit only the parsed data rows as a JSON array of objects, so "
                        "other tooling need not re-implement any of this")
    p.add_argument("-d", "--delimiter", default=",",
                   help="field delimiter (default ','; accepts 'tab', 'semicolon', 'pipe')")
    p.add_argument("--encoding", default="utf-8-sig",
                   help="text encoding (default utf-8-sig, which strips a BOM if present)")
    p.add_argument("--naive", action="store_true",
                   help="DIAGNOSTIC: turn the quirk handling off (no skipinitialspace, "
                        "no stripping of header keys or values) to see what a careless "
                        "read returns")
    p.add_argument("--selftest", action="store_true",
                   help="check the --digest stability and sensitivity claims against "
                        "synthetic files in a temp dir, and against a frozen golden "
                        "digest. No test framework, no fixtures, no network.")
    p.add_argument("--version", action="version", version="csv-measure " + VERSION)
    return p


def main(argv=None):
    parser = build_parser()
    if argv is None:
        argv = sys.argv[1:]
    if "--selftest" in argv:  # the only mode that needs no path argument
        sys.stdout.write("csv-measure {} selftest\n".format(VERSION))
        return 0 if selftest(sys.stdout) else 1
    args = parser.parse_args(argv)

    try:
        delimiter = _resolve_delimiter(args.delimiter)
    except CsvReadError as exc:
        print("csv-measure: {}".format(exc), file=sys.stderr)
        return 2

    group_specs = [[c.strip() for c in g.split(",") if c.strip()] for g in args.group]
    group_specs = [g for g in group_specs if g]

    # Parsed before any file is opened: a bad expectation is a bug in the caller's
    # baseline and must be loud whatever the file turns out to say.
    expectations = []
    if args.expect:
        try:
            expectations = parse_expectations(args.expect)
        except CsvReadError as exc:
            print("csv-measure: {}".format(exc), file=sys.stderr)
            return 2

    results = []
    failures = 0
    for path in args.path:
        try:
            results.append(read_csv(path, delimiter=delimiter,
                                    encoding=args.encoding, naive=args.naive))
        except CsvReadError as exc:
            print("csv-measure: {}".format(exc), file=sys.stderr)
            failures += 1
    if not results:
        return 1

    digests = [content_digest(r) for r in results] if args.digest else [None] * len(results)

    # A mismatch is exit 1 (the number moved); a bad expectation is exit 2 (the check
    # itself is wrong, e.g. a column that does not exist) and is raised out of here.
    all_checks = None
    mismatches = 0
    if expectations:
        try:
            all_checks = [evaluate_expectations(r, expectations) for r in results]
        except CsvReadError as exc:
            print("csv-measure: {}".format(exc), file=sys.stderr)
            return 2
        mismatches = sum(1 for checks in all_checks if any(not c["ok"] for c in checks))

    if args.rows_json:
        payload = results[0]["rows"] if len(results) == 1 else \
            {r["path"]: r["rows"] for r in results}
        json.dump(payload, sys.stdout, ensure_ascii=False, indent=2)
        sys.stdout.write("\n")
        if all_checks:  # stderr, so the JSON on stdout stays machine-readable
            for r, checks in zip(results, all_checks):
                print_expectations(r, checks, sys.stderr)
        return 1 if failures or mismatches else 0

    try:
        analyses = [
            ([distinct_report(r, c) for c in args.distinct],
             [group_report(r, g) for g in group_specs])
            for r in results
        ]
    except CsvReadError as exc:
        print("csv-measure: {}".format(exc), file=sys.stderr)
        return 2

    if args.json:
        payload = []
        for i, (r, (dists, grps)) in enumerate(zip(results, analyses)):
            item = dict(r)
            if digests[i]:
                item["digest"] = digests[i]
            if dists:
                item["distinct"] = dists
            if grps:
                item["groups"] = grps
            if all_checks:
                item["expect"] = all_checks[i]
            payload.append(item)
        json.dump(payload[0] if len(payload) == 1 else payload, sys.stdout,
                  ensure_ascii=False, indent=2)
        sys.stdout.write("\n")
        return 1 if failures or mismatches else 0

    # --digest on its own is a fingerprint command, not a report: one line per file,
    # digest first so it can be copied or cut straight into a baseline.
    if args.digest and not (all_checks or args.report or args.table or args.columns
                            or args.distinct or group_specs):
        for r, dg in zip(results, digests):
            sys.stdout.write("{}  {}\n".format(dg, r["path"]))
        sys.stdout.write(
            "\ndigest = sha256 over the parsed DATA ROWS only, normalised: unaffected by "
            "a BOM,\n        CRLF, alignment padding, appended note lines, a trailing "
            "newline, row order or\n        column order; changed by any cell value, row, "
            "or column name.\n")
        return 1 if failures else 0

    if all_checks:
        for i, (r, checks) in enumerate(zip(results, all_checks)):
            if i:
                sys.stdout.write("\n")
            print_expectations(r, checks, sys.stdout)
        # "assert, don't print": the report comes back only if it was asked for.
        if not (args.report or args.table):
            return 1 if failures or mismatches else 0
        sys.stdout.write("\n")

    as_table = args.table or (len(results) > 1 and not args.report
                              and not args.distinct and not group_specs
                              and not args.columns)
    if as_table:
        print_table(results, sys.stdout)
        if args.digest:  # the table has no room for it, but never silently drop it
            sys.stdout.write("\n")
            for r, dg in zip(results, digests):
                sys.stdout.write("{}  {}\n".format(dg, r["name"]))
    else:
        for i, (r, (dists, grps)) in enumerate(zip(results, analyses)):
            if i:
                sys.stdout.write("\n")
            print_report(r, dists, grps, args.columns, sys.stdout, digest=digests[i])

    return 1 if failures or mismatches else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        os._exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
