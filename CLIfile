# CLIfile — agent-facing CLI tools that Claude's skills invoke directly.
#
# Reproduced by install_cli_tools() in scripts/setup.sh. These are binaries
# that skills shell out to (nlm, playwright-cli, ctx7, defuddle, mcp2cli, ...)
# and that are NOT covered by Brewfile / Skillfile / Pluginfile — until now
# they were installed by hand on each machine.
#
# Format (pipe-delimited), one tool per line:
#   <name> | <verify-cmd> | <install-cmd>
#
# - <verify-cmd> runs first; exit 0 => already installed, skip (idempotent).
# - The first word of <install-cmd> (npm/bun/uv/npx) must be on PATH, or the
#   tool is skipped with a warning.
# - Lines starting with # and blank lines are ignored.
#
# NOTE: the glean / fellow / slack CLIs are handled by setup_pulse_sources()
#       (project-pulse context path), NOT here — do not duplicate them.
# NOTE: one-time INTERACTIVE auth is never scripted here (e.g. `nlm auth`,
#       `glean auth login`). This file only installs the binaries.

# nlm is GATED: pinned to the audited 0.8.2 (2026-09-29, SAFE-WITH-CAVEATS for CLI use; its
# MCP server must stay off / stdio-only), with fastmcp + mcp pinned too. Bump only after
# re-auditing; see README.MD. The verify-cmd must stay '|'-free.
nlm                 | [ "$(nlm --version 2>/dev/null)" = "nlm version 0.8.2" ] | uv tool install 'notebooklm-mcp-cli==0.8.2' --with 'fastmcp==3.4.2' --with 'mcp==1.28.1'
# mcp2cli is GATED: pinned to the audited 3.2.0 (2026-09-29, SAFE-WITH-CAVEATS) with its
# mcp SDK pinned too (mcp 2.x breaks 3.2.0). Bump only after re-auditing; see README.MD.
# No '|' allowed inside a field (it is the delimiter), hence the [ ] test.
mcp2cli             | [ "$(mcp2cli --version 2>/dev/null)" = "mcp2cli 3.2.0" ] | uv tool install 'mcp2cli==3.2.0' --with 'mcp==1.27.2'
ctx7                | ctx7 --version                                         | npm install -g ctx7@latest
defuddle            | defuddle --version                                     | bun add -g defuddle
playwright-cli      | playwright-cli --version                               | bun add -g @playwright/cli@latest
playwright-browsers | ls "$HOME/Library/Caches/ms-playwright"/chromium-* >/dev/null 2>&1 | npx --yes playwright install chromium
