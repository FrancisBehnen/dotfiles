#!/bin/bash
# piper-tts — Dutch Piper voices for VoiceMode, on an OpenAI-compatible endpoint.
# It also serves the macOS system voice "Claire (Enhanced)" as nl_NL-claire-enhanced
# (rendered silently with `say -o`; Francis's default Dutch voice since 2026-10-14).
#
#   piper-tts            start the server in the foreground (http://127.0.0.1:8893/v1)
#   piper-tts setup      create the venv and download the Dutch voices (idempotent)
#   piper-tts health     ask a running server which voices it has (Piper and say)
#
# Code lives here (~/scripts/piper-tts/, dotfiles repo). The venv and the voice models
# live outside git, in ~/.local/share/piper-tts/{venv,voices}/ (~330 MB of models).
# nl_NL-mls-medium has 52 speakers: request one as nl_NL-mls-medium-<0..51>.
# Start in the background by hand:
#   nohup ~/scripts/piper-tts/piper-tts >> ~/.voicemode/logs/piper-tts.log 2>&1 &
# Autostart: com.francisbehnen.piper-tts.plist next to this file — NOT installed;
# its header has the one-line install command.
# VoiceMode reaches it as the second VOICEMODE_TTS_BASE_URLS entry, after Kokoro;
# see server.py's docstring for why that routing works.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA="${PIPER_TTS_HOME:-$HOME/.local/share/piper-tts}"
VENV="$DATA/venv"
VOICES_DIR="$DATA/voices"
VOICES=(nl_NL-pim-medium nl_NL-ronnie-medium nl_BE-nathalie-medium nl_NL-alex-medium nl_NL-mls-medium)

case "${1:-serve}" in
  setup)
    mkdir -p "$VOICES_DIR"
    [ -x "$VENV/bin/python" ] || uv venv --python 3.12 "$VENV"
    uv pip install --python "$VENV/bin/python" 'piper-tts>=1.8,<2'
    "$VENV/bin/python" -m piper.download_voices --download-dir "$VOICES_DIR" "${VOICES[@]}"
    ;;
  health)
    curl -fsS "http://127.0.0.1:${PIPER_TTS_PORT:-8893}/health"; echo
    ;;
  serve)
    shift || true
    exec "$VENV/bin/python" "$HERE/server.py" --port "${PIPER_TTS_PORT:-8893}" \
      --voices-dir "$VOICES_DIR" "$@"
    ;;
  *)
    exec "$VENV/bin/python" "$HERE/server.py" --port "${PIPER_TTS_PORT:-8893}" \
      --voices-dir "$VOICES_DIR" "$@"
    ;;
esac
